# Copy to .env.local (never commit secrets)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Enables Apple Music link opening/catalog resolution UI. Keep false unless testing Apple links.
EXPO_PUBLIC_ENABLE_APPLE=false
# Optional dev auto-login
EXPO_PUBLIC_SUPABASE_DEV_EMAIL=dev@example.com
EXPO_PUBLIC_SUPABASE_DEV_PASSWORD=SuperSecret123!
