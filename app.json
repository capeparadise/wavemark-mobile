{
  "expo": {
    "name": "RPPL",
    "slug": "rppl-mobile",
    "owner": "cape4paradise",
    "scheme": [
      "wavemark",
      "rppl"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.capeparadise.rppl",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "music",
          "musics",
          "itms",
          "itmss",
          "spotify"
        ]
      }
    },
    "android": {
      "package": "com.capeparadise.rppl",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      "expo-image-picker",
      "expo-apple-authentication",
      "expo-router",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5e98e0c7-5d19-4d62-a08e-468a761d5eb5"
      }
    }
  }
}
